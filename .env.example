# Override the judge from suite.toml without editing it
# JUDGE_PROVIDER=ollama            # or "openai" for any OpenAI-compatible API
# JUDGE_MODEL=qwen2.5:7b
# JUDGE_BASE_URL=http://localhost:11434
# JUDGE_API_KEY=
# JUDGE_THINK=false                # reasoning models in Ollama (e.g. qwen3): turn thinking off

# Send traces to an OTLP backend (Jaeger, Tempo, Phoenix, Langfuse) instead of traces.jsonl only
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
